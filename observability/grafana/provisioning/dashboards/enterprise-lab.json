{
  "title": "Enterprise Backend Simulation Lab",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Outbox Pending",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "payment_outbox_pending",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox Processing / Failed",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "payment_outbox_processing",
          "legendFormat": "processing"
        },
        {
          "expr": "payment_outbox_failed",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Accounting Journal Creation",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(accounting_journal_created_total[1m])",
          "legendFormat": "journals/sec"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Accounting Kafka Event Processing",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(accounting_kafka_events_received_total[1m])",
          "legendFormat": "events/sec"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Memory Used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes",
          "legendFormat": "{{area}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hikari Active Connections",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 Latency",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "seconds"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx Rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "errors/s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "JVM GC Pause",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "seconds/s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Hikari Pending Connections",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "connections"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Kafka Listener Processing",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "expr": "rate(spring_kafka_listener_seconds_count[1m])",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "listeners/s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Inventory Cache Hit Rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "expr": "sum(rate(inventory_cache_hit_total[5m])) / clamp_min(sum(rate(inventory_cache_hit_total[5m])) + sum(rate(inventory_cache_miss_total[5m])), 1e-9)",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ratio"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Async Executor Queue",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "targets": [
        {
          "expr": "inventory_async_pool_queue",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tasks"
        },
        "overrides": []
      }
    }
  ]
}
